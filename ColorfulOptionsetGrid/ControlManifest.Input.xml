<?xml version="1.0" encoding="utf-8"?>
<manifest>
  <control namespace="Elad" 
           constructor="ColorfulOptionsetGrid" 
           version="0.3.39"
           display-name-key="Elad_ColorfulOptionsetGrid" 
           description-key="Elad_ColorfulOptionsetGrid_Description"
           control-type="virtual" preview-image="css/imgs/Preview.png">
    <!-- dataset node represents a set of entity records on CDS; allow more than one datasets -->
    <!--type-group name="colorfulTypes">
       <type>OptionSet</type>
       <type>TwoOptions</type>    
       <type>MultiSelectOptionSet</type>   
    </type-group-->
    <data-set name="dataset" display-name-key="Dataset" cds-data-set-options="displayCommandBar:true;displayViewSelector:true;displayquickfind:true">
      <!-- Custom Page cannot handle group-type -->
      <!--property-set name="optionset1" display-name-key="Optionset 1" description-key="Property_Desc_Key" of-type="TwoOptions" usage="bound" required="false" />
      <property-set name="optionset2" display-name-key="Optionset 2" description-key="Property_Desc_Key" of-type="TwoOptions" usage="bound" required="false" />
      <property-set name="optionset3" display-name-key="Optionset 3" description-key="Property_Desc_Key" of-type="TwoOptions" usage="bound" required="false" /-->
      <!--Model-driven-->
      <property-set name="optionset1" display-name-key="Optionset 1" description-key="Property_Desc_Key" of-type-group="colorfulTypes" usage="bound" required="false" />
      <property-set name="optionset2" display-name-key="Optionset 2" description-key="Property_Desc_Key" of-type-group="colorfulTypes" usage="bound" required="false" />
      <property-set name="optionset3" display-name-key="Optionset 3" description-key="Property_Desc_Key" of-type-group="colorfulTypes" usage="bound" required="false" />
      <!-- UNCOMMENT TO ADD PROPERTY-SET NODE
      <property-set name="samplePropertySet" display-name-key="Property_Display_Key" description-key="Property_Desc_Key" of-type="SingleLine.Text" usage="bound" required="true" />
      -->
    </data-set>
      <type-group name="colorfulTypes">
       <type>OptionSet</type>
       <type>TwoOptions</type>    
       <type>MultiSelectOptionSet</type>   
    </type-group>
    <property name="displayTextType" display-name-key="Display_text_type" description-key="Display text type" of-type="Enum" usage="input" required="true">
      <value name="SIMPLE" display-name-key="No decoration" description-key="No decoration" default="true">SIMPLE</value>
      <value name="BOX" display-name-key="Colorful background" description-key="Colorful background">BOX</value>
      <value name="BORDER" display-name-key="Colorful Border" description-key="Colorful Border">BORDER</value>
      <value name="NOTEXT" display-name-key="No text" description-key="Only the icon will be shown">NOTEXT</value>
    </property>
    <property name="displayIconType" display-name-key="Icon definition" description-key="Icon definition" of-type="Enum" usage="input" required="true">
      <value name="NONE" display-name-key="No icon" description-key="No icon">NONE</value>
      <value name="NAME" display-name-key="Icon name or JSON" description-key="Using the icon name or a JSON config {value: {icon, color}}" default="true">NAME</value>     
    </property>
    <property name="isEditable" display-name-key="isEditable" description-key="ColumnIsEditable" of-type="Enum" usage="input" required="true" >
      <value name="Editable" display-name-key="Editable" description-key="editable">Editable</value>
      <value name="ReadOnly" display-name-key="ReadOnly" description-key="ReadOnly" default="true">ReadOnly</value>
    </property>
    <property name="defaultIcon" display-name-key="Default Icon name" description-key="The default name of the icon" of-type="SingleLine.Text" usage="input" required="false" default-value="CircleShapeSolid" />
    <property name="iconConfig1" display-name-key="iconConfig1" description-key="iconConfig1" of-type="SingleLine.Text" usage="input" required="false" />
    <property name="iconConfig2" display-name-key="iconConfig2" description-key="iconConfig2" of-type="SingleLine.Text" usage="input" required="false" />
    <property name="iconConfig3" display-name-key="iconConfig3" description-key="iconConfig3" of-type="SingleLine.Text" usage="input" required="false" />
    <property name="showSearchAndFilters" display-name-key="showSearchAndFilters" description-key="Show or hide search and filters line" of-type="Enum" usage="input" required="true" default-value="true">
      <value name="false" display-name-key="false" description-key="Hide search and filters line.">false</value>
      <value name="true" display-name-key="true" description-key="Show search and filters line.">true</value>
    </property>
    <property name="searchableColumns" display-name-key="Searchable Columns" description-key="Searchable Columns" of-type="SingleLine.Text" usage="input" required="false"/>
    <property name="builtInFilterText1" display-name-key="builtInFilterText1 (Default)" description-key="Text for first built-in filter button" of-type="SingleLine.Text" usage="input" required="false"/>
    <property name="builtInFilterText2" display-name-key="builtInFilterText2" description-key="Text for second built-in filter button" of-type="SingleLine.Text" usage="input" required="false"/>
    <property name="builtInFilterText3" display-name-key="builtInFilterText3" description-key="Text for third built-in filter button" of-type="SingleLine.Text" usage="input" required="false"/>
    <property name="builtInFilterText4" display-name-key="builtInFilterText4" description-key="Text for fo built-in filter button" of-type="SingleLine.Text" usage="input" required="false"/>
    <property name="filterByIsuk" display-name-key="filterByIsuk?" description-key="filter by isuk?" of-type="Enum" usage="input" required="true" default-value="true">
      <value name="false" display-name-key="false" description-key="Do not filter by Isuk.">false</value>
      <value name="true" display-name-key="true" description-key="Filter by Isuk.">true</value>
    </property>
	  <property name="ShowIsukFilter" display-name-key="ShowIsukFilter?" description-key="Show isuk filter?" of-type="Enum" usage="input" required="true" default-value="true">
      <value name="false" display-name-key="false" description-key="Do not Show isuk filter.">false</value>
      <value name="true" display-name-key="true" description-key="Show isuk filter.">true</value>
    </property>
    <property name="dashboardMode" display-name-key="dashboardMode" description-key="Dashboard mode selector" of-type="Enum" usage="input" required="true" default-value="NONE">
      <value name="NONE" display-name-key="NONE" description-key="Use legacy behavior">NONE</value>
      <value name="THERAPIST" display-name-key="THERAPIST" description-key="Therapist queue dashboard">THERAPIST</value>
      <value name="PROVIDER" display-name-key="PROVIDER" description-key="Provider queue dashboard">PROVIDER</value>
    </property>
    <property name="therapistQueueName" display-name-key="therapistQueueName" description-key="Queue name for therapist dashboard" of-type="SingleLine.Text" usage="input" required="false" />
    <property name="providerQueueName" display-name-key="providerQueueName" description-key="Queue name for provider dashboard" of-type="SingleLine.Text" usage="input" required="false" />
    <property name="requireActiveOnly" display-name-key="requireActiveOnly" description-key="Only active incidents" of-type="Enum" usage="input" required="true" default-value="true">
      <value name="false" display-name-key="false" description-key="Do not enforce incident active state">false</value>
      <value name="true" display-name-key="true" description-key="Enforce incident active state">true</value>
    </property>
    <property name="incidentActiveStateCode" display-name-key="incidentActiveStateCode" description-key="StateCode value that means active on incident" of-type="SingleLine.Text" usage="input" required="false" default-value="0" />
    <property name="queueItemAlias" display-name-key="queueItemAlias" description-key="Entity alias for queueitem in the source view" of-type="SingleLine.Text" usage="input" required="false" default-value="queueitem" />
    <property name="queueAlias" display-name-key="queueAlias" description-key="Entity alias for queue in the source view" of-type="SingleLine.Text" usage="input" required="false" default-value="queue" />
    <property name="waitingQueueItemStateCode" display-name-key="waitingQueueItemStateCode" description-key="StateCode value that means waiting on queueitem" of-type="SingleLine.Text" usage="input" required="false" default-value="1" />
    <property name="waitingQueueItemStatusCode" display-name-key="waitingQueueItemStatusCode" description-key="StatusCode value that means waiting on queueitem" of-type="SingleLine.Text" usage="input" required="false" default-value="2" />
    <property name="genderAttribute" display-name-key="genderAttribute" description-key="Incident field for gender filter" of-type="SingleLine.Text" usage="input" required="false" default-value="mac_p_member_gender" />
    <property name="languageAttribute" display-name-key="languageAttribute" description-key="Incident field for language filter" of-type="SingleLine.Text" usage="input" required="false" default-value="mac_p_preferred_language" />
    <property name="dayAttribute" display-name-key="dayAttribute" description-key="Incident field for day filter" of-type="SingleLine.Text" usage="input" required="false" default-value="mac_p_preffered_day" />
    <property name="timeAttribute" display-name-key="timeAttribute" description-key="Incident field for time filter" of-type="SingleLine.Text" usage="input" required="false" default-value="mac_p_preferred_time" />
    <property name="queueTypeAttribute" display-name-key="queueTypeAttribute" description-key="Incident field for preferred queue type filter" of-type="SingleLine.Text" usage="input" required="false" default-value="mac_p_preferred_queue_type" />
    <property name="cityLinkAlias" display-name-key="cityLinkAlias" description-key="Entity alias for incident-city link entity in the source view" of-type="SingleLine.Text" usage="input" required="false" default-value="citylink" />
    <property name="cityLookupAttribute" display-name-key="cityLookupAttribute" description-key="Lookup field name to city on the city link entity" of-type="SingleLine.Text" usage="input" required="false" default-value="mac_cityid" />
    <property name="showDashboardFilters" display-name-key="showDashboardFilters" description-key="Show dashboard search filters" of-type="Enum" usage="input" required="true" default-value="true">
      <value name="false" display-name-key="false" description-key="Hide dashboard search filters">false</value>
      <value name="true" display-name-key="true" description-key="Show dashboard search filters">true</value>
    </property>

    <resources>
      <code path="index.ts" order="1" />
      <css path="css/ColorfulOptionsetGrid.css" order="1" />
      <resx path="strings/ColorfulOptionsetGrid.1033.resx" version="1.0.0" />
      <platform-library name="React" version="16.8.6" />
      <platform-library name="Fluent" version="8.29.0" />
      <img path="App/Controls/phone.png" />
      <!-- UNCOMMENT TO ADD MORE RESOURCES
      <css path="css/ColorfulOptionsetGrid.css" order="1" />
      <resx path="strings/ColorfulOptionsetGrid.1033.resx" version="1.0.0" />
      -->
    </resources>
    <feature-usage>
      <uses-feature name="Utility" required="true" />
      <uses-feature name="WebAPI" required="true" />
    </feature-usage>
    <!-- UNCOMMENT TO ENABLE THE SPECIFIED API
    <feature-usage>
      <uses-feature name="Device.captureAudio" required="true" />
      <uses-feature name="Device.captureImage" required="true" />
      <uses-feature name="Device.captureVideo" required="true" />
      <uses-feature name="Device.getBarcodeValue" required="true" />
      <uses-feature name="Device.getCurrentPosition" required="true" />
      <uses-feature name="Device.pickFile" required="true" />
      <uses-feature name="Utility" required="true" />
      <uses-feature name="WebAPI" required="true" />
    </feature-usage>
    -->
  </control>
</manifest>